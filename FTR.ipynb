from reportlab.lib.pagesizes import A4
from reportlab.lib import colors
from reportlab.pdfgen import canvas

# Create the PDF file
file_name = "Handwritten_Style_Physiotherapy_Essay.pdf"
c = canvas.Canvas(file_name, pagesize=A4)
width, height = A4

x_margin = 72  # 1 inch
y_start = height - 72
line_height = 16

# Student Info
student_info = [
    "Name: [Your Full Name]",
    "Student ID: [Your Student Number]",
    "Class/Year: BPT 2nd Year",
    "School: [Your School/College Name]",
    "Professor: [Prof. Name if required]",
    "Date: April 14, 2025",
]

y = y_start
c.setFont("Times-Roman", 12)
for line in student_info:
    c.drawString(x_margin, y, line)
    y -= line_height

# Leave space before title
y -= line_height * 1.5
c.setFillColor(colors.red)
c.setFont("Times-Bold", 14)
c.drawCentredString(width / 2, y, "Recent Technological Devices in Physiotherapy and Rehabilitation")
y -= line_height * 2
c.setFont("Times-Roman", 12)
c.setFillColor(colors.black)

# Essay content
essay_lines = [
    "Physiotherapy and rehabilitation are essential components of recovery for individuals suffering from",
    "injuries, surgeries, or neurological conditions. Physiotherapy focuses on restoring movement and function",
    "through physical methods such as exercises, massage, and manual therapy. Rehabilitation, a broader term,",
    "aims to help individuals regain independence and improve their quality of life. In recent years, technology",
    "has significantly enhanced these processes, making therapy more efficient, engaging, and accessible.",
    "",
    "With the integration of advanced technology, physiotherapists now have access to innovative tools",
    "that assist in diagnosis, treatment, and monitoring. These devices not only improve patient outcomes",
    "but also make therapy sessions more motivating and personalized.",
    "",
    "Among the most notable technological advancements in this field are:",
    "",
    "1. Robotic Exoskeletons – Wearable robotic suits that assist patients in walking again after spinal",
    "    injuries or strokes.",
    "2. Virtual Reality (VR) Systems – Immersive environments that help patients practice balance and",
    "    coordination in fun, simulated scenarios.",
    "3. Functional Electrical Stimulation (FES) – Devices that send electrical impulses to muscles, helping",
    "    patients with paralysis regain movement.",
    "4. Wearable Motion Sensors – Devices that monitor posture, gait, and movement, providing real-time",
    "    feedback for both therapists and patients.",
    "5. Tele-rehabilitation Platforms – Online systems that allow patients to receive therapy remotely,",
    "    which is especially useful for those in remote areas.",
    "",
    "Among these, Virtual Reality (VR) has emerged as a particularly impactful tool. VR systems provide",
    "patients with interactive exercises that simulate real-life tasks, such as walking through a street or",
    "reaching for objects. These simulations are not only engaging but also help rewire neural pathways",
    "through repetitive, goal-oriented actions. Research has shown that VR can significantly enhance",
    "motivation, adherence to therapy, and functional improvement, especially in stroke or brain injury patients.",
    "",
    "In conclusion, the integration of modern technology into physiotherapy and rehabilitation has",
    "revolutionized the way treatment is delivered. Devices like VR systems, robotic exoskeletons, and wearable",
    "sensors are not just high-tech tools—they are life-changing innovations. Technology is making rehabilitation",
    "more effective, personalized, and widely accessible, giving hope and improved outcomes to patients across",
    "the world.",
]

for line in essay_lines:
    if y < 72:
        c.showPage()
        c.setFont("Times-Roman", 12)
        y = y_start
    c.drawString(x_margin, y, line)
    y -= line_height

c.save()
